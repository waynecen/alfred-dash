# Copy this file to .env and fill it in. .env is git-ignored; never commit a real key.
# The key is read only by the AI proxy (server/aiHandler.js), which runs in Node. It is never
# sent to the browser. Get a key at https://console.anthropic.com/settings/keys
# Optional: leave it empty and each user enters their own key in Settings instead.

ANTHROPIC_API_KEY=

# Optional: which Claude model the AI widgets use (default: claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: port for the stand-alone proxy started by `npm run api` (default: 8787).
# AI_PROXY_PORT=8787

# Hosted only (Vercel), and only to share ANTHROPIC_API_KEY: the access key a visitor must enter
# in Settings to use your key rather than their own. Pick a long random string. Leave it unset and
# a hosted site never spends your key: every visitor uses their own. Not needed on your computer.
# AI_ACCESS_KEY=
