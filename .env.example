# Copy this file to .env and fill it in. .env is git-ignored; never commit a real key.
# The key is read only by the AI proxy (server/aiHandler.js), which runs in Node. It is never
# sent to the browser. Get a key at https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=

# Optional: which Claude model the AI widgets use (default: claude-opus-5-5).
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: port for the stand-alone proxy started by `npm run api` (default: 8787).
# AI_PROXY_PORT=8787

# Hosted only (Vercel): the access key the dashboard must send to use the AI. Pick a long random
# string, set it in the Vercel project's Environment Variables, and enter the same one in the
# dashboard's Settings. Not needed on your own computer.
# AI_ACCESS_KEY=
